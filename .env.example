# ===========================================
# Cookbook - Umgebungsvariablen
# ===========================================
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# -------------------------------------------
# Datenbank (PostgreSQL)
# -------------------------------------------
POSTGRES_DB=cookbook
POSTGRES_USER=cookbook
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# -------------------------------------------
# Backend
# -------------------------------------------
# Geheimer Schluessel fuer JWT-Token (zufaellige Zeichenkette)
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET_STRING

# AES-256-GCM-Schluessel fuer die Verschluesselung sensibler Daten (z. B. Zeit-Cookie).
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 Hex-Zeichen ODER 44 Base64-Zeichen = 32 Bytes.
ENCRYPTION_KEY=CHANGE_ME_TO_32_BYTE_HEX_OR_BASE64_KEY

# Umgebung: development oder production
NODE_ENV=development

# -------------------------------------------
# Ports
# -------------------------------------------
FRONTEND_PORT=3002
BACKEND_PORT=4002
POSTGRES_PORT=5435
MCP_PORT=4003

# -------------------------------------------
# Google OAuth (optional)
# -------------------------------------------
# Erstelle eine Client-ID unter:
# https://console.cloud.google.com/apis/credentials
#
# Fuer das Frontend muss zusaetzlich frontend/.env erstellt werden:
# VITE_GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_ID=

# -------------------------------------------
# MCP-Server (Rezepte aus Claude heraus pflegen)
# -------------------------------------------
# Erreichbar unter https://cookbook.gout-diary.com/mcp - der Frontend-Container
# leitet /mcp an den MCP-Container weiter. Die Anmeldung laeuft ueber
# "Mit Google anmelden", genau wie auf der Website; es sind also KEINE
# Zugangsdaten zu hinterlegen.
#
# Voraussetzung: GOOGLE_CLIENT_ID (siehe oben) muss gesetzt sein.

# Interner Port des MCP-Containers (nicht nach aussen veroeffentlicht)
MCP_PORT=4003

# Oeffentliche Adresse der Website, ohne Pfad. Muss https sein.
MCP_PUBLIC_URL=https://cookbook.gout-diary.com

# Optional: abweichende API-URL (Standard ist der Backend-Container im Docker-Netz)
# MCP_COOKBOOK_API_URL=http://backend:4002

# Optional: zusaetzlich erlaubte Ruecksprung-Origins fuer OAuth-Clients.
# Loopback-Adressen sind immer erlaubt. Standard deckt Claude ab.
# MCP_ALLOWED_REDIRECT_ORIGINS=https://claude.ai,https://claude.com
