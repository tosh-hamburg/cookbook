# ===========================================
# Cookbook - Umgebungsvariablen
# ===========================================
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# -------------------------------------------
# Datenbank (PostgreSQL)
# -------------------------------------------
POSTGRES_DB=cookbook
POSTGRES_USER=cookbook
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# -------------------------------------------
# Backend
# -------------------------------------------
# Geheimer Schluessel fuer JWT-Token (zufaellige Zeichenkette)
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET_STRING

# AES-256-GCM-Schluessel fuer die Verschluesselung sensibler Daten (z. B. Zeit-Cookie).
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 Hex-Zeichen ODER 44 Base64-Zeichen = 32 Bytes.
ENCRYPTION_KEY=CHANGE_ME_TO_32_BYTE_HEX_OR_BASE64_KEY

# Umgebung: development oder production
NODE_ENV=development

# -------------------------------------------
# Ports
# -------------------------------------------
FRONTEND_PORT=3002
BACKEND_PORT=4002
POSTGRES_PORT=5435

# -------------------------------------------
# Google OAuth (optional)
# -------------------------------------------
# Erstelle eine Client-ID unter:
# https://console.cloud.google.com/apis/credentials
#
# Fuer das Frontend muss zusaetzlich frontend/.env erstellt werden:
# VITE_GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_ID=
