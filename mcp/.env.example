# Beispielkonfiguration fuer den lokalen Betrieb (stdio).
# Fuer den Docker-Betrieb kommen die Werte aus der .env im Projektwurzelverzeichnis.

COOKBOOK_API_URL=https://api.cookbook.gout-diary.com

# Entweder Benutzername + Passwort ...
COOKBOOK_USERNAME=
COOKBOOK_PASSWORD=

# ... oder ein fertiges JWT (noetig bei aktivierter 2FA)
# COOKBOOK_TOKEN=

# stdio (Standard) oder http
MCP_TRANSPORT=stdio

# Nur fuer MCP_TRANSPORT=http:
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=4003
# MCP_AUTH_TOKEN=
